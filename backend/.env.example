# Copy this file to backend/.env and fill in the password. Never commit .env.
PGHOST=ep-morning-sound-aujg3fb5-pooler.c-10.us-east-1.aws.neon.tech
PGDATABASE=easyreports4.0_tally_abd296b5203a437aa233f12df68280b0
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require
PGSCHEMA=public

# How long query results are kept in memory (seconds). "Refresh data" in the dashboard clears it.
CACHE_TTL_SECONDS=900

# Companies (Tally keeps one per financial year). History uses all that match; balances use the latest.
COMPANY_INCLUDE_REGEX=^DAMODARA OIL MILL
# CURRENT_COMPANY=DAMODARA OIL MILL - (from 1-Apr-25)
HISTORY_YEARS=5

# Which salesanalysis column holds each dimension
DIM_ROUTE=partygroupl3
DIM_CITY=partygroupl4
DIM_AGENT=costcentreclass
DIM_ZONE=zone

# Conversion and billing assumptions
KG_PER_LITRE=0.91
GST_BILLING_FACTOR=1.05

# Offline demo: run on the Excel extract instead of the database
# DEMO_EXCEL=C:/path/to/Latest_views_10_Nov.xlsx

# Delta refresh: after the first full load, only recent rows are re-read
DELTA_ENABLED=1
DELTA_OVERLAP_DAYS=45
DELTA_FULL_RELOAD_HOURS=24

# ---------------------------------------------------------------- sign-in
# Long random string that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# First admin account, created at startup if there is no admin yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_HOURS=12
# Where the dashboard is opened (used in reset-email links) and which sites may call the API
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=*
# AUTH_REQUIRED=0   # local development only: turns sign-in off

# ---------------------------------------------------------------- Google Sheets
# Service-account key JSON (paste the whole JSON on one line, or base64 of it),
# or a path to the key file for local development
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=C:/keys/damodara-service-account.json
# Spreadsheet ids (the long part of the sheet URL between /d/ and /edit)
USERS_SHEET_ID=
KPI_SHEET_ID=
# Automatic KPI export every N minutes (0 = only with the button)
SHEETS_EXPORT_INTERVAL_MINUTES=0

# ---------------------------------------------------------------- password-reset email
# smtp = Gmail with an App Password; resend = Resend HTTPS API (if SMTP ports are blocked)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# RESEND_API_KEY=
